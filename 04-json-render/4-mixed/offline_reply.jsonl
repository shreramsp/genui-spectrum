{"op": "add", "path": "/elements/frame-1", "value": {"type": "HtmlFrame", "props": {"html": "<style>\nbody{font-family:system-ui,sans-serif;margin:0;padding:12px;color:#1b1f24}\n.lbl{display:flex;justify-content:space-between;font-size:13px;color:#667085}\ninput[type=range]{width:100%;accent-color:#c2378c}\n.day{display:flex;gap:6px;margin:10px 0;flex-wrap:wrap}\n.slot{flex:1 1 90px;background:#fdf0f7;border-radius:8px;padding:8px;font-size:13px;text-align:center}\nbutton{margin-top:6px;background:#c2378c;color:#fff;border:0;border-radius:8px;padding:8px 14px;font-weight:600;cursor:pointer}\n</style>\n<b>How packed should each day be?</b>\n<input id=\"pace\" type=\"range\" min=\"1\" max=\"3\" value=\"2\">\n<div class=\"lbl\"><span>Relaxed</span><span>Balanced</span><span>Packed</span></div>\n<div class=\"day\" id=\"preview\"></div>\n<button id=\"apply\">Apply this pace</button>\n<script>\nconst names={1:\"relaxed\",2:\"balanced\",3:\"packed\"};\nconst slots={1:[\"Late breakfast\",\"1 sight\",\"Long dinner\"],2:[\"Breakfast\",\"2 sights\",\"Café break\",\"Dinner\"],3:[\"Early start\",\"3 sights\",\"Quick lunch\",\"Market\",\"Night views\"]};\nfunction draw(){preview.innerHTML=slots[pace.value].map(s=>`<div class=\"slot\">${s}</div>`).join(\"\");}\npace.oninput=draw; draw();\napply.onclick=()=>sendAction(\"set_pace\",{pace:names[pace.value]});\n</script>", "height": 230, "actions": ["set_pace"]}, "children": []}}
{"op": "add", "path": "/elements/chart-1", "value": {"type": "BarChart", "props": {"title": "Budget by category (USD)", "labels": ["Hotel", "Food", "Activities", "Transit"], "values": [420, 180, 90, 45]}, "children": []}}
