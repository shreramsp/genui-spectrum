root = Stack([title, intro, stats, days, costs, next])
title = Text("Tokyo in 3 days", "heading")
intro = Text("Temples, neon and food markets, using the subway for everything.")
stats = Stack([m_days, m_budget, m_walk], "row")
m_days = Metric("Days", 3)
m_budget = Metric("Est. budget", "$735", "excluding flights")
m_walk = Metric("Walking per day", "~12 km")
days = Card("Day by day", [plan])
plan = Table(["Day", "Morning", "Afternoon", "Evening"], [["1", "Senso-ji", "Sumida river walk", "Ueno izakaya"], ["2", "Meiji Shrine", "Shibuya crossing", "Shinjuku views"], ["3", "Tsukiji market", "Akihabara", "Ikebukuro ramen"]])
costs = BarChart("Budget by category (USD)", ["Hotel", "Food", "Activities", "Transit"], [420, 180, 90, 45])
next = Button("Suggest cheaper options", "cheaper")
