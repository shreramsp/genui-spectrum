root = Stack([title, stats, plan, costs, tip])
title = Text({{title}}, "heading")
stats = Stack([days, total], "row")
days = Metric("Days", {{n_days}})
total = Metric("Estimated budget", {{total}}, "excluding flights")
plan = Card("Itinerary", [table])
table = Table(["Day", "Plan"], {{rows}})
costs = BarChart("Budget by category (USD)", {{labels}}, {{values}})
tip = Text({{tip}}, "small")
